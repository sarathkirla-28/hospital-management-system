# Intelligent Hospital Management System Environment Configuration Template
# Copy this file to .env and customize values for production deployment

# Web Server Port (Defaults to 8082 matching PPT specification)
PORT=8082

# JSON Web Token Secret Key
JWT_SECRET=replace_with_a_long_random_cryptographic_secret_in_production

# Relational Database Connection URI
# Leave blank to use self-contained SQLite database at server/data/hospital.db
# Or provide PostgreSQL URI for cloud production:
# DATABASE_URL=postgresql://username:password@localhost:5432/hospital_db

# Environment mode
NODE_ENV=development
